# Copy this file to .env and replace ONLY the placeholders below.
# Never commit a real .env or bot token.

# Discord application -> Bot -> Token (placeholder only)
DISCORD_TOKEN=replace_with_your_bot_token

# Discord application -> Application ID (placeholder only)
DISCORD_CLIENT_ID=replace_with_your_application_id

# Optional: a test server ID for instant command registration during setup.
# Leave blank to register global commands (can take up to 1 hour to appear).
DISCORD_GUILD_ID=

# Optional: private channel ID where the bot mirrors audit entries.
# The bot needs View Channel + Send Messages + Embed Links there.
LOG_CHANNEL_ID=

# Optional: user ID of a fixed staff member to mention in join welcomes.
# Leave blank to mention only the new member. Requires Server Members intent.
WELCOME_MENTION_USER_ID=

# Optional: GitHub release polling interval in milliseconds (default 900000 = 15 min).
# Minimum 60000. The bot ignores drafts and prereleases.
RELEASE_POLL_INTERVAL_MS=900000

# Optional: local state file for the last seen stable release tag.
# Default data/release-state.json. Railway's filesystem is ephemeral.
RELEASE_STATE_PATH=data/release-state.json

# HTTP health check port used by Railway (Railway injects PORT automatically).
PORT=3000

# Append-only JSONL action log. Railway's filesystem is ephemeral; stdout
# JSON logs are the durable source of truth unless you add external storage.
ACTION_LOG_PATH=data/actions.jsonl
